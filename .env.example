# Example environment variables for Segmentation Service MQ layer
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Celery connection strings
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://

# Resource allocation settings
# Total CPU allocation for the application (percentage of total CPU, e.g. 0.8 = 80%)
TOTAL_CPU_ALLOCATION=0.8

# Distribution between workers (percentage of allocated CPU)
# Math worker gets 60% of allocated CPU
MATH_WORKER_CPU_SHARE=0.6
# DB worker gets 40% of allocated CPU
DB_WORKER_CPU_SHARE=0.4

# Concurrency settings (number of parallel tasks)
MATH_WORKER_CONCURRENCY=3
DB_WORKER_CONCURRENCY=2
