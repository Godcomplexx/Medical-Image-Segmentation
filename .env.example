# Example environment variables for the Segmentation Service.
# Скопируйте в `.env` и задайте реальные значения. Файл `.env` не коммитится.

# === PostgreSQL ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=patient

# === pgAdmin (доступен только на 127.0.0.1:5050) ===
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=change-me-admin-password

# === RabbitMQ ===
RABBITMQ_USER=change-me-rabbit-user
RABBITMQ_PASS=change-me-rabbit-password

# === Celery connection strings ===
CELERY_BROKER_URL=amqp://change-me-rabbit-user:change-me-rabbit-password@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://

# === API authentication ===
# JWT_SECRET_KEY: длинный случайный секрет, напр. `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# INTERNAL_API_TOKEN: общий секрет для server-to-server вызовов воркеров к API
INTERNAL_API_TOKEN=change-me-internal-service-token

# === Resource allocation settings ===
# Total CPU allocation for the application (percentage of total CPU, e.g. 0.8 = 80%)
TOTAL_CPU_ALLOCATION=0.8

# Distribution between workers (percentage of allocated CPU)
# Math worker gets 60% of allocated CPU
MATH_WORKER_CPU_SHARE=0.6
# DB worker gets 40% of allocated CPU
DB_WORKER_CPU_SHARE=0.4

# Concurrency settings (number of parallel tasks)
MATH_WORKER_CONCURRENCY=3
DB_WORKER_CONCURRENCY=2
